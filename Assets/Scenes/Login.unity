      _hindi: {fileID: 8300000, guid: 3fe90debb9f5ba845bebc40d52d0e379, type: 3}
      subText: 'Pull the jig outward '
    - _english: {fileID: 8300000, guid: 3f35f3fe6128435459d1fc99ab73f598, type: 3}
      _hindi: {fileID: 8300000, guid: b8bbfa4871a4bda4f898bb94b69b379e, type: 3}
      subText: Pick Remocon from jig using left hand
    - _english: {fileID: 8300000, guid: eb5045ed057e0b74d9ba248cca9055be, type: 3}
      _hindi: {fileID: 8300000, guid: 9a529d889f1c72a429d25c03b128f4fd, type: 3}
      subText: 'Pick Emergency key from tray using right hand '
    - _english: {fileID: 8300000, guid: bdeeb45f0c22d8047a34f7734bfbdbd2, type: 3}
      _hindi: {fileID: 8300000, guid: 838b081782657df4bae3b10467239ed8, type: 3}
      subText: Insert Emergency key in the Remocon as highlighted
    - _english: {fileID: 8300000, guid: a4498efbab53c20488f4a1a4974b41d2, type: 3}
      _hindi: {fileID: 8300000, guid: a10966e5aa738744a99eeabd985f9952, type: 3}
      subText: Go to Function Checker stage. Place and Align the Remocon in the Function
        Checker as highlighted
    - _english: {fileID: 8300000, guid: 64f0213e47c1dfe448ae0e3fee6be851, type: 3}
      _hindi: {fileID: 8300000, guid: 2f7677eae890a184a94799b1d3f0914e, type: 3}
      subText: Close the door and Wait for the Result on monitor screen
    - _english: {fileID: 8300000, guid: a388a7a0b2b6e5345a823dde733a4e6a, type: 3}
      _hindi: {fileID: 8300000, guid: a49744d4584917e47bfe464e7c7fedb7, type: 3}
      subText: Open the door
    - _english: {fileID: 8300000, guid: 224c0769fd5281a44a7731f0c24581df, type: 3}
      _hindi: {fileID: 8300000, guid: b9cffb99a2a7cb24c999a1633c6d2baa, type: 3}
      subText: 'Pick Remocon from Function Checker using left hand '
    - _english: {fileID: 8300000, guid: b4f6301c4de0ed94ba0a4a9e014c9bda, type: 3}
      _hindi: {fileID: 8300000, guid: cdec7df347574d94a9e8188c23721df4, type: 3}
      subText: Now, Move to Immobi communication checker stage. Place and Align the
        Remocon onto the jig as highlighted
    - _english: {fileID: 8300000, guid: b2c74af600ddbee4da01b0999b840439, type: 3}
      _hindi: {fileID: 8300000, guid: a6b81cdbab944e347a7c7afaeaa9461a, type: 3}
      subText: Wait for the Result on monitor screen
    - _english: {fileID: 8300000, guid: 03218041427d0d347acb2bb25cfd2efc, type: 3}
      _hindi: {fileID: 8300000, guid: 5beecb1bbda9e8d4abd0165f805636ad, type: 3}
      subText: 'Pick Remocon from Immobi communication checker using left hand '
    - _english: {fileID: 8300000, guid: 343f479d85abf6e459b37a4c435de308, type: 3}
      _hindi: {fileID: 8300000, guid: 6423875c38b4edb42973cb6813e4ea0b, type: 3}
      subText: 'Now, Move to LF Reception sensitivity check stage. Place and Align
        the Remocon onto the jig as highlighted '
    - _english: {fileID: 8300000, guid: c1a07fa115ccebb42a98e89ad3302f22, type: 3}
      _hindi: {fileID: 8300000, guid: 44c03befd39f1a5468d6048d2eaba0d5, type: 3}
      subText: 'Close the door and Wait for the Result on monitor screen '
    - _english: {fileID: 8300000, guid: b5da232d4c4bdd8418884398e1e811ac, type: 3}
      _hindi: {fileID: 8300000, guid: 89d5a6ea376b4f74babf38000298b160, type: 3}
      subText: 'Open the door '
    - _english: {fileID: 8300000, guid: ae6d40b1eb07ccc4792f90accedc37d2, type: 3}
      _hindi: {fileID: 8300000, guid: e2622ab02729d934f9ca5c99bdea2d69, type: 3}
      subText: 'Pick Remocon from LF Reception sensitivity check using left hand '
    - _english: {fileID: 8300000, guid: bfe4ba3422c29514da7a809023108650, type: 3}
      _hindi: {fileID: 8300000, guid: 3c230659fd82b824282fe4ab10e9ff37, type: 3}
      subText: 'Remove the Emergency Key from the Remocon by grabbing it with the
        right hand '
    - _english: {fileID: 8300000, guid: 73ac5b8a64a3ab44b870b88d9130a8f2, type: 3}
      _hindi: {fileID: 8300000, guid: b522705f59bdae8429185b65f3e73146, type: 3}
      subText: Place Emergency key on the table as highlighted
    - _english: {fileID: 8300000, guid: 19fe9ded13bf11f4398b4878ab05b084, type: 3}
      _hindi: {fileID: 8300000, guid: 307e58dfda8b7254c99607c7ee2602e3, type: 3}
      subText: 'Now, Move to Packing stage and place Remocon in the tray '
    - _english: {fileID: 8300000, guid: 7bcc0bd1db3836d4aae58a222db38963, type: 3}
      _hindi: {fileID: 8300000, guid: 7dd0b25411942f5468919dc44d3acc09, type: 3}
      subText: 'Congratulations! '
