      subText: 'Now pick another Circuit Assembly from tray using left hand '
    - _english: {fileID: 8300000, guid: 4defee7cc2ea68f42a812d2695d1df95, type: 3}
      _hindi: {fileID: 8300000, guid: 7aab8ca158dd5584c8b56f9ed856aaa6, type: 3}
      subText: 'Place Circuit assembly in the LF Auto Tuning machine same as highlighted '
    - _english: {fileID: 8300000, guid: 53ace4912ca1734419238e7e48fff209, type: 3}
      _hindi: {fileID: 8300000, guid: 7ad91ec32b10c3243992beb1463b13e3, type: 3}
