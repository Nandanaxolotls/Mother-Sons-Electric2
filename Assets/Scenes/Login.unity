      _hindi: {fileID: 8300000, guid: 4c187e0f5786795428c78bfcef3f273c, type: 3}
      subText: 'Wait for the Result on monitor screen '
    - _english: {fileID: 8300000, guid: d8816c3a0ddf13e4893407b7774298a7, type: 3}
      _hindi: {fileID: 8300000, guid: 5d27293bd5b6d4a449d2de969a23351e, type: 3}
      subText: 'Unlock the door '
    - _english: {fileID: 8300000, guid: 058fb27e807089a4087d5373739cfe41, type: 3}
      _hindi: {fileID: 8300000, guid: bc0d59e1cb71bde408865d50aff03995, type: 3}
      subText: 'Open the door '
    - _english: {fileID: 8300000, guid: b6efca7da4a03064db0067d6aef273e6, type: 3}
      _hindi: {fileID: 8300000, guid: 6554136dd5b57d5448a45acaecdae022, type: 3}
      subText: Pick the Circuit Assembly from the LF Auto Tuning
    - _english: {fileID: 8300000, guid: f3fb49ddf0aadd14dad2cfdc8d97b770, type: 3}
      _hindi: {fileID: 8300000, guid: 2a86e82969d32be4898e3be48fb1bc01, type: 3}
      subText: 'Now, Move to Current check stage. Place and Align the Circuit Assembly
        onto the highlighted jig '
    - _english: {fileID: 8300000, guid: 5f72a818654fd174a807adbdcee24f04, type: 3}
      _hindi: {fileID: 8300000, guid: 8c9c76a172cd80740bc9c2071af60ee1, type: 3}
      subText: 'Close the flap using right hand '
    - _english: {fileID: 8300000, guid: 45986795a0527fb40bb70f78d8886608, type: 3}
      _hindi: {fileID: 8300000, guid: 8656b00627dc8724da91bec92e22920a, type: 3}
      subText: Pick Case upper from tray using left hand
    - _english: {fileID: 8300000, guid: aa5f01dd09292f44b86df9ff90c0501b, type: 3}
      _hindi: {fileID: 8300000, guid: cd48178436806ca4c80be6e86b624e54, type: 3}
      subText: 'Pick Switch knob unlock from tray using right hand '
    - _english: {fileID: 8300000, guid: a9d7c53493700284fbff0a289a50da61, type: 3}
      _hindi: {fileID: 8300000, guid: bd6dad628da17644e8f1710b065c27ea, type: 3}
      subText: 'Place Switch knob on the Case upper as highlighted '
    - _english: {fileID: 8300000, guid: b1d4f3a052920cc45986a263e9085f5e, type: 3}
      _hindi: {fileID: 8300000, guid: f935f548733902f48832c99a205b7775, type: 3}
      subText: 'Pick Switch knob lock from tray using right hand '
    - _english: {fileID: 8300000, guid: a9d7c53493700284fbff0a289a50da61, type: 3}
      _hindi: {fileID: 8300000, guid: 703b898a47204dd46a7fd9499114922c, type: 3}
      subText: 'Place Switch knob on the Case upper as highlighted '
    - _english: {fileID: 8300000, guid: 477f9080dc00f7141b92cad842ab33c7, type: 3}
      _hindi: {fileID: 8300000, guid: 10689641d688a0e47a8cfca368237f96, type: 3}
      subText: 'Pick Rubber from tray using right hand '
    - _english: {fileID: 8300000, guid: 4f4e6bcfe74136641b32dc14534c2db9, type: 3}
      _hindi: {fileID: 8300000, guid: 0913b9226faec9c46a4cdd437e5af21e, type: 3}
      subText: 'Place Rubber on the Case upper as highlighted '
    - _english: {fileID: 8300000, guid: bb841379047b202429f2a3535750c0f4, type: 3}
      _hindi: {fileID: 8300000, guid: b7797fddb70f9814a8986f917a048922, type: 3}
      subText: Open the flap using right hand
    - _english: {fileID: 8300000, guid: 802276a213c5bfe4f8950c4549d90f7a, type: 3}
      _hindi: {fileID: 8300000, guid: 00f882ccd128a764db0d7a359ab66bb3, type: 3}
      subText: 'Pick Circuit Assembly from jig '
    - _english: {fileID: 8300000, guid: b1e92a4980443644fb6b9723e269c060, type: 3}
      _hindi: {fileID: 8300000, guid: 08b34dc5d3669654f89db29b4cc47f69, type: 3}
      subText: 'Place Circuit Assembly on the Case upper as highlighted '
    - _english: {fileID: 8300000, guid: 1519691e8b249c14692779b7eb1fdf2c, type: 3}
      _hindi: {fileID: 8300000, guid: c019ad5e2e204bb47968e28512ad2ec9, type: 3}
      subText: 'Now, Move to Case inner sub assembly stage. Place and Align the Case
        upper onto the Pressing machine jig '
    - _english: {fileID: 8300000, guid: 4f76ece1d835c68428bdb943cd3570cd, type: 3}
      _hindi: {fileID: 8300000, guid: 36134f2fcb257e54da20d36fb51b2fd1, type: 3}
      subText: Pick Case Inner from tray
    - _english: {fileID: 8300000, guid: 183655887e50b2347949df34595b1564, type: 3}
      _hindi: {fileID: 8300000, guid: d0795b5f2996e854e9058c2acfcc4d14, type: 3}
      subText: Place Case Inner on the Case upper as highlighted
    - _english: {fileID: 8300000, guid: d05d1848e89b1f140a2e2c8e0529d68f, type: 3}
      _hindi: {fileID: 8300000, guid: 5a7c40f6b8848c349a9a7b635226df71, type: 3}
      subText: 'Pull the lever to press the Case Inner into the Case Upper Sub Assembly '
    - _english: {fileID: 8300000, guid: 13b3d89f572460e49ad6d995dd873f3f, type: 3}
      _hindi: {fileID: 8300000, guid: 8bd8100727e191643b05970b544aa0dd, type: 3}
      subText: 'Pick Case Upper Sub Assembly from Pressing machine using left hand '
    - _english: {fileID: 8300000, guid: 43477a912a741a246a3bdfff66fcb67a, type: 3}
      _hindi: {fileID: 8300000, guid: 93ade9def53dd484492f5026f23dae37, type: 3}
      subText: Pick Battery from tray
    - _english: {fileID: 8300000, guid: 9c33ccc87a1ab4947b456a9b68da1ee3, type: 3}
      _hindi: {fileID: 8300000, guid: d2085dcf38ea42c4b8dc1654540527c2, type: 3}
      subText: 'Place Battery on the Case Upper Sub Assembly as highlighted '
    - _english: {fileID: 8300000, guid: ee7b0e4992979d8449d62856895d314d, type: 3}
      _hindi: {fileID: 8300000, guid: 168f90ccf546c914fb859aef76fc9dde, type: 3}
      subText: 'Now, Move to Case fitting stage. Place and Align the Case Upper Sub
        Assembly onto the highlighted jig '
    - _english: {fileID: 8300000, guid: 5c3b68a8011f00b4a97340c8d5b3fa28, type: 3}
      _hindi: {fileID: 8300000, guid: bb1b04630fdda9d4ebb0287652782f24, type: 3}
      subText: Pick Case Lower Sub Assembly from tray using left hand
    - _english: {fileID: 8300000, guid: 230d5b889a2df5d43ba71faa63c65e99, type: 3}
      _hindi: {fileID: 8300000, guid: 8c379264ae5b5f94b9f2b88988d9e66a, type: 3}
      subText: 'Place it on the jig as highlighted '
    - _english: {fileID: 8300000, guid: 3aa2088f13b829a44a68bf6eb27987cc, type: 3}
      _hindi: {fileID: 8300000, guid: f8c539ff3e3edb744956585c283ec53e, type: 3}
      subText: 'Press the button on right to start the process and Wait for the Result
        on monitor screen '
    - _english: {fileID: 8300000, guid: 5358dc4bef7486848a046f27c3ed9f5d, type: 3}
      _hindi: {fileID: 8300000, guid: ec84c6b4521cace4eb1306e62c215be4, type: 3}
      subText: Pick Case Lower Sub Assembly from jig
    - _english: {fileID: 8300000, guid: 75d5496b5e95aa341ab2c07d741ef21e, type: 3}
      _hindi: {fileID: 8300000, guid: e0134c8b73f341c44a364e9f28c7fb28, type: 3}
      subText: 'Place it on the Case Upper Sub Assembly as highlighted '
    - _english: {fileID: 8300000, guid: 8bd9cf60206861347b6a2f02464df122, type: 3}
      _hindi: {fileID: 8300000, guid: 7ae76a35d5bfa474a97b2d5b0da2e640, type: 3}
      subText: Push the jig forward
    - _english: {fileID: 8300000, guid: a8363b3d5b1aff64fb7ae0d48bda6289, type: 3}
      _hindi: {fileID: 8300000, guid: 6961c9e02ea1392489765efc95d2e50e, type: 3}
      subText: 'Pull the lever to press the Case Lower Sub Assy into the Case Upper
        Sub Assy '
