    - _english: {fileID: 8300000, guid: 48f49c536c79b2d4687ac93331cce874, type: 3}
      _hindi: {fileID: 8300000, guid: 75a4f64ef3dfb7b40aaaf053a6faf4ef, type: 3}
      subText: 'Close the NG box '
    - _english: {fileID: 8300000, guid: c7945b4d0419dce45a7a349f1d3cabb7, type: 3}
      _hindi: {fileID: 8300000, guid: 70971d9042ae6e24589fb4d863c25df8, type: 3}
      subText: 'Now take another antenna sub assembly from tray using left hand '
    - _english: {fileID: 8300000, guid: 026dbc28f3c5cc84a89637f3310f7d90, type: 3}
      _hindi: {fileID: 8300000, guid: ac186494bfd2c884a97f9698bebfcb0d, type: 3}
      subText: 'Now pick circuit assembly from tray using right hand '
    - _english: {fileID: 8300000, guid: 092d45c60f10f9a4fa93eaf9ff7a7375, type: 3}
      _hindi: {fileID: 8300000, guid: 0f611584a4aaec14e9f32bebc2fec208, type: 3}
      subText: It is a NG circuit assembly so put this child part in the NG box
    - _english: {fileID: 8300000, guid: 0ee1681a857c32640a75233d09e5ee87, type: 3}
      _hindi: {fileID: 8300000, guid: 98664388385907844a2eee6f80e6b4bb, type: 3}
      subText: 'Release Good antenna from hand '
    - _english: {fileID: 8300000, guid: e7876ddb61945ba4180365976197bb6f, type: 3}
      _hindi: {fileID: 8300000, guid: 98a782f395dbf4043ab55820726e83db, type: 3}
      subText: Open the NG box
    - _english: {fileID: 8300000, guid: 4db7a3d1195b4854a816bac08cc45417, type: 3}
      _hindi: {fileID: 8300000, guid: fb22a224057c831489686a91b033a5c8, type: 3}
      subText: 'Place NG circuit assembly in the NG box '
    - _english: {fileID: 8300000, guid: f84a79e3ce3d1b042ab1566dfa9dfc6f, type: 3}
      _hindi: {fileID: 8300000, guid: 76d217628160f5c4086b2853772c6172, type: 3}
      subText: Close the NG box
    - _english: {fileID: 8300000, guid: 1768368f3eca0f345be140871fdb48f3, type: 3}
      _hindi: {fileID: 8300000, guid: 70a243dcd84a27747ad0fadc6efd8cf5, type: 3}
      subText: 'Now take another antenna sub assembly from tray using left hand '
    - _english: {fileID: 8300000, guid: 089f48a89b18eb141944eb24894699cc, type: 3}
      _hindi: {fileID: 8300000, guid: 09ffb6a4e109d5c49ae9a36543d1ca7e, type: 3}
      subText: 'Now pick circuit assembly from tray using right hand '
    - _english: {fileID: 8300000, guid: 09b0ae7923ab2f641956feac329f96ac, type: 3}
      _hindi: {fileID: 8300000, guid: d10949e46e79b144aad76293bee6ffab, type: 3}
      subText: Place circuit assembly on the antenna sub assembly same as highlighted
    - _english: {fileID: 8300000, guid: e00c73df5f0fa3a419dfde8db36b50fb, type: 3}
      _hindi: {fileID: 8300000, guid: 3deb290f6d7e0804693700bc15714f62, type: 3}
      subText: Ensure before pressing that the 5 pins of antenna sub assembly are
        temporary set on PCB holes
    - _english: {fileID: 8300000, guid: 63867996c23004e46a795cf7c06a2c09, type: 3}
      _hindi: {fileID: 8300000, guid: 38c21afc5d159164c8f68d3dcc04acc2, type: 3}
      subText: 'Go to the manual pressing machine and place the antenna sub assembly
        on the jig as highlighted '
    - _english: {fileID: 8300000, guid: 44faccc5d966ebc42901539aa33d2c48, type: 3}
      _hindi: {fileID: 8300000, guid: d631462c63dfff2439be2fcc92950905, type: 3}
      subText: 'After placing antenna sub assembly on jig , now close the toggle
        clamp '
    - _english: {fileID: 8300000, guid: 980e96b2e12d3a341a00748eeac185a1, type: 3}
      _hindi: {fileID: 8300000, guid: 4db9665f70ad1eb43950aaa924890c49, type: 3}
      subText: 'Always remember to close the toggle clamp '
    - _english: {fileID: 8300000, guid: 00379ec94a656304887020823c6bd02a, type: 3}
      _hindi: {fileID: 8300000, guid: b7120af9203ab5f4ba96d2fd1fdb7e5f, type: 3}
      subText: Pull the lever to press the circuit assembly into the antenna sub
        assembly
    - _english: {fileID: 8300000, guid: eab309f2c67b50c429f73f8aee768deb, type: 3}
      _hindi: {fileID: 8300000, guid: 2924b6ec77205954f8f98370cc0b698a, type: 3}
      subText: 'Open the toggle clamp '
    - _english: {fileID: 8300000, guid: 2b42668daae29e040a958b9bb8c24bed, type: 3}
      _hindi: {fileID: 8300000, guid: 60b9653d90c1b6a44bfdfd518ef49b8d, type: 3}
      subText: 'Pick antenna sub assembly from manual pressing machine '
    - _english: {fileID: 8300000, guid: f1a5d916961e1194b9deb6db31a856dc, type: 3}
      _hindi: {fileID: 8300000, guid: d591c1c3d1fab2744af4cdbd7d5ff8b7, type: 3}
