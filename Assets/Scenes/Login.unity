      _hindi: {fileID: 8300000, guid: 2cc19c7d0821867489b7853f00d98c73, type: 3}
      subText: Open the door of function checker using right hand
    - _english: {fileID: 8300000, guid: c3a784901f036b14e936ae5e0fc9fb22, type: 3}
      _hindi: {fileID: 8300000, guid: 48474c58c4065fa458b4e47578eebc0d, type: 3}
      subText: 'Open the toggle clamp '
    - _english: {fileID: 8300000, guid: 1e9f6161320308a4297cc4a89dab719c, type: 3}
      _hindi: {fileID: 8300000, guid: bd8bb234469b07a43ac1898d8534c6ff, type: 3}
      subText: 'Now disconnect wire from port '
    - _english: {fileID: 8300000, guid: e4c313b5240b0ca47a86f5feb1763803, type: 3}
      _hindi: {fileID: 8300000, guid: d9c19dc3fc5f40646a539c1c76edcf8a, type: 3}
      subText: 'Pick antenna sub assembly from Function checker jig '
    - _english: {fileID: 8300000, guid: 9c1ea4f1e7a495e41b948d3d2cfbaf1a, type: 3}
      _hindi: {fileID: 8300000, guid: 29bbe1a8a1b24014b9c95faa3e28ede3, type: 3}
      subText: Go to the next stage which is Label pasting and place it on the jig
        as highlighted
    - _english: {fileID: 8300000, guid: c6edcec39066e3c41b27fb987676bbb5, type: 3}
      _hindi: {fileID: 8300000, guid: 0f1955f584580554ab36cfdd1d39f174, type: 3}
      subText: 'Grab label from label printing machine '
    - _english: {fileID: 8300000, guid: 00dfcc9d19142df48b7a456a7f885e7f, type: 3}
      _hindi: {fileID: 8300000, guid: 514dd79788134524da2ff0a9908b0f5f, type: 3}
      subText: 'It is a NG label so put this label in the NG bin '
    - _english: {fileID: 8300000, guid: cd7b3660468931b4cb86526712e991c6, type: 3}
      _hindi: {fileID: 8300000, guid: e8061b12f2c1dac46b99ed3b0a03fa8c, type: 3}
      subText: 'Grab another label from label pasting machine '
    - _english: {fileID: 8300000, guid: 144d5bc2b222854429ceb383ea214242, type: 3}
      _hindi: {fileID: 8300000, guid: 25f942f3beda94d4191a6655bc130b0d, type: 3}
      subText: 'Stick label on the antenna sub assembly as highlighted '
    - _english: {fileID: 8300000, guid: ad930c1a53c52904d8b005ac00aa5849, type: 3}
      _hindi: {fileID: 8300000, guid: cf4d8ecdc9b268240847ec0624ffe2d9, type: 3}
      subText: Close the flap using left hand
    - _english: {fileID: 8300000, guid: fbb1cd20eba688b4d87e145c8bd62e3b, type: 3}
      _hindi: {fileID: 8300000, guid: d45dcdf0d1628ad418eb0f22d6190a03, type: 3}
      subText: 'Press green button '
    - _english: {fileID: 8300000, guid: 9b2b664365d59604096275d373b0a005, type: 3}
      _hindi: {fileID: 8300000, guid: 6fea5aad2b9834942b9e3fd8a6f54c83, type: 3}
      subText: 'Open the flap using left hand '
    - _english: {fileID: 8300000, guid: 5781fcc599c8a5b4aa4b1858fe27489e, type: 3}
      _hindi: {fileID: 8300000, guid: 7097dcaedd3b95a40944382bb93b82a8, type: 3}
      subText: 'Grab the marker '
    - _english: {fileID: 8300000, guid: 36c39c9c10d8ec241a266d9d4a62a1e8, type: 3}
      _hindi: {fileID: 8300000, guid: a20c0273f14aa8049b1bb54a1587ab4a, type: 3}
      subText: Make marking on antenna sub assembly as highlighted
    - _english: {fileID: 8300000, guid: 39aa8b17eed17e344a3f3ab050e8a72a, type: 3}
      _hindi: {fileID: 8300000, guid: 8d91d02a0be142f4fa47af8d36434137, type: 3}
      subText: Leave marker on table and pick antenna sub assembly from label pasting
        jig
    - _english: {fileID: 8300000, guid: 31f8db9ce304b194a9003e1f5548c445, type: 3}
      _hindi: {fileID: 8300000, guid: 37ec00f5bd6ec4d458996ce66d991bb2, type: 3}
      subText: Now place the antenna sub assembly into the packing box and pack 12
        antenna sub assembly at once in a row
    - _english: {fileID: 8300000, guid: 7c559850cc8cc5b488ac2f6c128c647d, type: 3}
      _hindi: {fileID: 8300000, guid: dd274d2ac07224e46a850068d8262d38, type: 3}
      subText: Congratulation!
  - TotalScore: 0
    LevelName: P2TOK
    voiceOverDatas:
    - _english: {fileID: 8300000, guid: bb271bd890006d1419d0ffb615edb5cd, type: 3}
      _hindi: {fileID: 8300000, guid: 168fa1698bc30f448b1953075aba7784, type: 3}
