      _hindi: {fileID: 8300000, guid: cabbb1fa86d61ba4895a18d5432b7125, type: 3}
      subText: Close the door
    - _english: {fileID: 8300000, guid: 19fdb473fa2551146bd6469151d09c30, type: 3}
      _hindi: {fileID: 8300000, guid: d7fcb647a9a85314e9081dd0ad907204, type: 3}
      subText: 'Lock the door '
